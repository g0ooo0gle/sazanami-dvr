# Sazanami DVRが所有するDBとバックアップの保存先
SAZANAMI_DATA_ROOT=/var/lib/sazanami-dvr

# 完成録画と録画途中ファイルの保存先
SAZANAMI_RECORDING_ROOT=/var/lib/sazanami-dvr/recordings

# 保存済み番組表と照合するチャンネル設定
SAZANAMI_CHANNEL_MAP=/var/lib/sazanami-dvr/channels.json

# MirakurunまたはmirakcのHTTP URL
SAZANAMI_MIRAKURUN_URL=http://127.0.0.1:40772

# KonomiTVやKomorebiから接続するCtrlCmdの待受
SAZANAMI_CTRLCMD_LISTEN=0.0.0.0:4520

# 録画履歴HTTPの待受
SAZANAMI_RECORDING_HTTP_LISTEN=127.0.0.1:4521

# 手動で起動するWebUIの待受
SAZANAMI_WEBUI_LISTEN=127.0.0.1:4522

# 同時録画数は固定せず、起動時にMirakurunの設定台数を一度取得します。
# 固定する場合はdocs/linux-installation.mdのsystemd drop-inを使います。
